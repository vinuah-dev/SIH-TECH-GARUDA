{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SENTINEL-X: synthetic demo (no model needed)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "synthetic",
        "--detector",
        "sim",
        "--force-night"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: loitering escalation (2 alerts)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "synthetic",
        "--detector",
        "sim",
        "--synthetic-frames",
        "360",
        "--linger",
        "--force-night"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: camera tampering",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "synthetic",
        "--detector",
        "sim",
        "--tamper",
        "--force-night"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: demo video (real YOLO)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "data/samples/border_demo.mp4",
        "--force-night"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: vehicles + ANPR + registry",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "data/samples/border_demo.mp4",
        "--detect",
        "all",
        "--registry",
        "config/vehicle-registry.json",
        "--force-night",
        "--db"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: calibrated camera (metres)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "synthetic",
        "--detector",
        "sim",
        "--zones",
        "config/zones-calibrated.json",
        "--force-night"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: webcam + live view",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--source",
        "webcam:0",
        "--view",
        "--force-night"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: whole fleet",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--cameras",
        "config/cameras.json",
        "--view",
        "--db"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "SENTINEL-X: dashboard server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/serve.py",
      "args": [
        "--view"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
